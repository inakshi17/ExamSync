\blueheading{Project Approach}

\vspace{1mm}

\answerbox[15cm]{
\noindent Requirement
\begin{itemize}[leftmargin=2.5em,label=$\bullet$,itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt]
\item data of students, rooms, available room and the available teachers.
\end{itemize}

\vspace{1mm}

\noindent Implementation of OOPs
\begin{itemize}[leftmargin=2.5em,label=$\bullet$,itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt]
\item In C++ programming language.
\item Classes for students, teachers, seating arrangement, examination and rooms.
\item Encapsulation for data and functions, inheritance and polymorphism gives runtime flexibility.
\item constructors initialize the objects.
\end{itemize}

\vspace{1mm}

\noindent Data Management using DSA
\begin{itemize}[leftmargin=2.5em,label=$\bullet$,itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt]
\item Arrays for static records.
\items pointers or linked lists for dynamic data.
\item Hashing for needed information .
\item Searching and sorting algorithms find and order records efficiently.
\end{itemize}

\vspace{1mm}

\noindent Generating the Smart Seating Plan
\begin{itemize}[leftmargin=2.5em,label=$\bullet$,itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt]
\item The admin enters student, examination, room, and seat details.
\item The system assigns seats according to DSA algorithms to prevent conflicts.
\end{itemize}

\vspace{1mm}

\noindent Student Module
\begin{itemize}[leftmargin=2.5em,label=$\bullet$,itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt]
\item The students log in to view examination information.
\item Searching and hashing retrieve examination and seating information.
\item The portal provides an option to access or download the admit card.
\end{itemize}

\vspace{1mm}

\noindent Teacher Module
\begin{itemize}[leftmargin=2.5em,label=$\bullet$,itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt]
\item The teachers log in to view their assigned duty (Invigilator / Flying Squad).
\item Searching finds the duty assigned to a teacher.
\item The authorized faculty records the UFM information.
\end{itemize}

\vspace{1mm}

\noindent Admin Module
\begin{itemize}[leftmargin=2.5em,label=$\bullet$,itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt]
\item The admin manages student, teacher, examination, room, and seating records using DSA and hashing techniques.
\item Searching and sorting find records; the admin generates seating arrangements.
\end{itemize}
}

